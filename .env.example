# Copy this file to ".env" in the cvai folder root and fill your values.
# NEVER share this file — keys stay on your machine.

# From Firebase Console → Project Settings → Your apps (Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Your Replit backend URL (from the Replit webview, e.g. https://care-vision-ai.username.repl.co)
# The Gemini AI key stays on that server — NOT in this file.
EXPO_PUBLIC_AI_BACKEND_URL=
